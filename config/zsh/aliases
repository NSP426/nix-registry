dlv_arte () {
   DEST_DIR="${HOME}/Vidéos"
   VENV_DIR="${HOME}/venv_yt"

   if [[ "$VIRTUAL_ENV" != "${VENV_DIR}" ]]
   then
      source "${VENV_DIR}/bin/activate"
   fi

   yt-dlp --list-formats "${1}" \
     && vared -p 'Which item(s): ' -c ITEMS \
     && yt-dlp --no-warnings --cookies-from-browser firefox -P "${DEST_DIR}" -f "${ITEMS}" "${1}" \
     && yt-dlp --no-warnings --cookies-from-browser firefox -P "${DEST_DIR}" --sub-format "srt" --sub-langs fr --write-subs "${1}"
}
