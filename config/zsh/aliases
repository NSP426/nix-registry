ocd_flash() {
    SCRIPTS=/usr/share/openocd/scripts/
    INTERFACE="${SCRIPTS}/interface/$1.cfg"
    TARGET="${SCRIPTS}/target/$2.cfg" 

    openocd -f $INTERFACE -f $TARGET -c init -c "reset init" -c halt -c "program $3 verify" -c reset -c exit
}

ocd_erase() {
    SCRIPTS=/usr/share/openocd/scripts/
    INTERFACE="${SCRIPTS}/interface/$1.cfg"
    TARGET="${SCRIPTS}/target/$2.cfg" 

    openocd -f $INTERFACE -f $TARGET -c init -c "reset init" -c halt -c "nrf5 mass_erase" -c reset -c exit
}

dirmod () {
    find "$1" -type d -exec chmod "$2" {} \;
}

filemod () {
    find "$1" -type f -exec chmod "$2" {} \;
}

